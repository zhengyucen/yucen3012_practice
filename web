  { id: "toriki", name: "鳥貴族", cat: "food", cube: 3.3, kumamon: 8.5, richart: 3.8, jfubon: 3 },
  { id: "matsuya", name: "松屋 / すき家", cat: "food", cube: 3.3, kumamon: 8.5, richart: 3.8, jfubon: 3 },
  // 一般保底
  { id: "other", name: "一般店家 / 街邊攤商 (無特店)", cat: "default", cube: 3.3, kumamon: 2.5, richart: 3.8, jfubon: 3 }
];

let selectedShopId = "biccamera";

function initButtons() {
  shopData.forEach(shop => {
    const btn = document.createElement("button");
    btn.className = `shop-btn ${shop.id === selectedShopId ? 'active' : ''}`;
    btn.innerText = shop.name;
    btn.onclick = () => selectShop(shop.id);
    const container = document.getElementById(`cat-${shop.cat}`);
    if(container) container.appendChild(btn);
  });
}

function selectShop(id) {
  selectedShopId = id;
  document.querySelectorAll(".shop-btn").forEach(b => b.classList.remove("active"));
  const clicked = Array.from(document.querySelectorAll(".shop-btn")).find(b => {
    const item = shopData.find(s => s.name === b.innerText);
    return item && item.id === id;
  });
  if(clicked) clicked.classList.add("active");
  calc();
}

function calc() {
  const shop = shopData.find(s => s.id === selectedShopId) || shopData[0];
  const scene = document.querySelector('input[name="scene"]:checked').value;
  const amount = parseFloat(document.getElementById("amount").value) || 0;
  
  let list = [];

  // 1. 國泰 CUBE 卡
  if(document.getElementById("cube").checked){
    let rate = shop.cube, note = "日本賞權益/切換即時生效，回饋無上限";
    if(scene.startsWith("paypay")){
      rate = 0;
      note = "不支援日本 PayPay 條碼優惠 (此情境不推薦)";
    } else if(scene === "direct_large"){
      note = "小樹點回饋無上限，高單價商品首選保證入帳";
    }
    list.push({ name: "國泰 CUBE 卡", rate, note });
  }

  // 2. 玉山熊本熊卡
  if(document.getElementById("kumamon").checked){
    let rate = shop.kumamon, note = "免 1.5% 交易手續費 + 指定通路加碼";
    if(scene === "direct_large"){
      rate = 2.5;
      note = "加碼回饋上限易滿(通常NT$300~500)，大額溢出部分以基本 2.5% 計算";
    } else if(scene === "paypay_normal"){
      rate = 6.5;
      note = "玉山 Wallet App 綁定掃 PayPay，免 1.5% 手續費並享專屬高額加碼";
    } else if(scene === "paypay_large"){
      rate = 2.5;
      note = "PayPay 活動加碼額度封頂後降為 2.5% 基本雙幣回饋";
    }
    list.push({ name: "玉山熊本熊雙幣卡", rate, note });
  }

  // 3. 台新 Richart / 玫瑰卡
  if(document.getElementById("richart").checked){
    let rate = shop.richart, note = "海外日韓指定方案 3.8% 台新 Point 回饋無上限";
    if(scene === "paypay_normal"){
      rate = 4.5;
      note = "透過街口支付綁定 Richart / 玫瑰卡掃 PayPay，免 1.5% 海外手續費";
    } else if(scene === "paypay_large"){
      rate = 2.0;
      note = "街口電支跨境條碼有單筆/每月點數回饋上限，高額建議切換為無上限直刷";
    } else if(scene === "direct_large"){
      rate = 3.8;
      note = "大筆刷方案 3.8% 無上限，大額採購電器最省心首選";
    }
    list.push({ name: "台新 Richart / 玫瑰卡", rate, note });
  }

  // 4. 富邦 J 卡
  if(document.getElementById("jfubon").checked){
    let rate = shop.jfubon, note = "日本實體一般消費最高 3% (需注意登錄或門檻)";
    if(scene.startsWith("paypay")){
      rate = 0;
      note = "主要以 JCB 實體過卡感應為主，無直接整合之 PayPay 條碼回饋";
    } else if(scene === "direct_large"){
      rate = 3.0;
      note = "高額請留意加碼活動之回饋上限限制";
    }
    list.push({ name: "富邦 J 卡", rate, note });
  }

  const out = document.getElementById("out");
  if(list.length === 0){
    out.innerHTML = '<div class="card warn">⚠️ 請至少勾選上方一張你持有的信用卡！</div>';
    return;
  }

  list.sort((a,b) => b.rate - a.rate);

  let html = `<div class="card"><h3>🎯 最佳推薦：${shop.name}</h3>`;
  list.forEach((item, idx) => {
    const isBest = idx === 0 && item.rate > 0;
    const money = amount ? (amount * item.rate / 100).toFixed(0) : 0;
    
    html += `
      <div class="result-item ${isBest ? 'best' : ''}">
        ${isBest ? '<span class="badge">🏆 最佳首選</span>' : ''}
        <div class="res-header">
          <span class="res-name">${item.name}</span>
          <span class="res-rate">${item.rate > 0 ? item.rate + '%' : '不適用'}</span>
        </div>
        ${amount && item.rate > 0 ? `<div class="res-money">預估可拿約 NT$ ${money} 回饋</div>` : ''}
        <div class="res-detail">${item.note}</div>
      </div>
    `;
  });
  html += `</div>`;
  out.innerHTML = html;
}

initButtons();
calc();
</script>
</body>
</html>
